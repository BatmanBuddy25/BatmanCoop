@page "/member-list"

@rendermode InteractiveAuto


<PageTitle>Member</PageTitle>
<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div style="width:100%;">
        <FluentGrid Justify="JustifyContent.SpaceBetween">
            <FluentGridItem>
                <FluentLabel Typo="Typography.H3"> Member List </FluentLabel>
            </FluentGridItem>
            <FluentGridItem>
                <FluentStack VerticalAlignment="VerticalAlignment.Center">                    
                    <button class="btn btn-dark" type="button" @onclick="OnAddMember">
                        <i class="bi bi-plus-lg" /> Add
                    </button>
                </FluentStack>
            </FluentGridItem>
        </FluentGrid>        
    </div>
    <div class="main-page-box" style="width: 100%;">
        <div style="width: 100%;border-radius: 12px;">
            <FluentDataGrid Items="@IList_Mem" Pagination="@pagination" ShowHover="true" GenerateHeader="GenerateHeaderOption.Sticky">
                <ChildContent>
                    <PropertyColumn Property="@(a => a.MemberNo)" Title="Member No." Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.LastName)" Title="Last Name" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.FirstName)" Title="First Name" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Contact)" Title="Contact No." Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.ReferralName)" Title="Referal Name" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.RegisterDate.ToShortDateString())" Title="Register Date" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.MemStatus)" Title="Status" Width=".5fr" Sortable="true" />
                    <TemplateColumn Title="Actions" Align="@Align.Center" Width=".5fr">
                        <FluentButton aria-label="View" IconEnd="@(new Icons.Regular.Size16.Eye())" OnClick="@(() => OnSelectItem(context))" />
                    </TemplateColumn>
                </ChildContent>
                <EmptyContent>
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
                        <div> No Data Found</div>
                    </FluentStack>
                </EmptyContent>
            </FluentDataGrid>
            <FluentPaginator State="@pagination" />
        </div>        
    </div>
</FluentStack>





