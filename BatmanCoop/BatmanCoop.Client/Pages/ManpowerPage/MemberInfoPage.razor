@page "/member-info"
@rendermode InteractiveAuto

<div>
    <div class="row">
        <div class="col-sm-12 col-md-3">
            <div class="d-flex flex-column left-panel gap-3">
                <div class="d-flex justify-content-center">
                    <div style="position: relative;">
                        <FluentPersona Class="@ImgBorderStatus(Obj?.Id ?? 0)" Image="@ImgProfile" ImageSize="230px"></FluentPersona>
                        <div style="position: absolute;top: 12px;right: 12px;">
                            <FluentInputFile OnInputFileChange="@OnFileUploadedAsync" AnchorId="MyUpdateImg" DragDropZoneVisible="false" Mode="InputFileMode.Stream" Multiple="false" Accept="image/*" />
                            <button id="MyUpdateImg" class="btn btn-update-img"><i class="bi bi-pencil-fill"></i></button>
                            <FluentTooltip Anchor="MyUpdateImg" Delay="0" Position="TooltipPosition.Bottom">Change Image</FluentTooltip>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-column align-items-center gap-1">
                    <div class="left-panel-name">@Obj?.FirstName @Obj?.LastName</div>
                    @* <div class="@StatusChipColor(Obj?.StatusId ?? 0)">@Obj?.MemStatus</div> *@
                </div>

                <div class="d-flex flex-column gap-2">
                    <div class="d-flex flex-column my-details-box">
                        <div class="my-labels">Mem Status</div>
                        <div class="my-details">@Obj?.EmailAdd</div>
                    </div>
                   @*  <div class="d-flex flex-column my-details-box">
                        <div class="my-labels">Company ID No.</div>
                        <div class="my-details">@Obj?.EmployeeNo</div>
                    </div>
                    <div class="d-flex flex-column my-details-box">
                        <div class="my-labels">Date Hired</div>
                        <div class="my-details">@Obj?.DateHired.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="d-flex flex-column my-details-box">
                        <div class="my-labels">Email</div>
                        <div class="my-details">@Obj?.Email</div>
                    </div>
                    <div class="d-flex flex-column my-details-box">
                        <div class="my-labels">Phone</div>
                        <div class="my-details">@(Obj?.MobileNumber == "" ? "-" : $"+63{@Obj?.MobileNumber}")</div>
                    </div>
                    <div class="d-flex flex-column my-details-box">
                        <div class="my-labels">Position</div>
                        <div class="my-details">@Obj?.SubPosition?.Position?.Name</div>
                    </div> *@
                </div>
            </div>
        </div>
        <div class="col">
            <FluentDataGrid Items="@IList_BuyerMem"
                            Pagination="@pagination"
                            ShowHover="true"
                            GenerateHeader="GenerateHeaderOption.Sticky"
                            Style="height: 100%;overflow:auto;">

                <ChildContent>
                    <PropertyColumn Property="@(a => a.MemM!.MemberNo)" Title="Member No." Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.MemM!.LastName +", "+ a.MemM!.FirstName)" Title="Name" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.MemM!.Bank_Number)" Title="Payment No." Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Share_Capital)" Title="Amount" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Share_Points)" Title="Points" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Created_Date.ToShortDateString())" Title="Date" Width=".5fr" Sortable="true" />
                    <PropertyColumn Property="@(a => a.Buy_Status)" Title="Status" Width=".5fr" Sortable="true" />
                </ChildContent>
                <EmptyContent>
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
                        <div> No Data Found</div>
                    </FluentStack>
                </EmptyContent>
            </FluentDataGrid>
            <FluentPaginator State="@pagination" />
        </div>
    </div>
</div>