@implements IDialogContentComponent


<style>
    fluent-tabs::part(activeIndicator) {
        width: 85%;
    }
</style>

<FluentDialogHeader ShowDismiss="false">
    <div class="d-flex flex-column">
        <FluentLabel Typo="Typography.PaneHeader">
            New Member
        </FluentLabel>
    </div>
</FluentDialogHeader>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" hidden="@isEntReferal">
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="form-label">Referal Code:</label>
                    <FluentTextField @bind-Value="Obj.ReferralId" Style="width: 100%;" Class="form-control" />
                </div>
            </div>
        </div>
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top:20px;">
            <FluentButton IconStart="@(new Icons.Regular.Size16.Search())" Appearance="Appearance.Accent"  OnClick="OnInquireref">
                Search
            </FluentButton>
            <FluentButton IconStart="@(new Icons.Regular.Size16.Dismiss())" Appearance="Appearance.Accent" OnClick="OnCloseDialog">
                Close
            </FluentButton>
        </FluentStack>
    </FluentStack>

    <FluentWizard Style="height: auto !important; " @bind-Value="@WizardIndex" @ref="@MyWizard" StepperPosition="StepperPosition.Top" StepSequence="WizardStepSequence.Linear" DisplayStepNumber="@(WizardStepStatus.Current | WizardStepStatus.Next)" hidden="@isViewFields">
        <Steps>
            <FluentWizardStep Label="Step 1">
                <div style="padding-left: 8px;">
                    <EditForm Model="@Obj" OnValidSubmit="OnNextTab" style="width:100%;">
                        <DataAnnotationsValidator />
                       @*  <ValidationSummary/> *@
                        <div class="row">
                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Last Name:</label>
                                    <FluentTextField @bind-Value="Obj.LastName" Class="form-control" />
                                    <ValidationMessage For="@(() => Obj.LastName)" />
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label class="form-label">First Name:</label>
                                    <FluentTextField @bind-Value="Obj.FirstName" Class="form-control" />
                                    <ValidationMessage For="@(() => Obj.FirstName)" />
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Middle Name:</label>
                                    <FluentTextField @bind-Value="Obj.MiddleName" Class="form-control" />
                                    <ValidationMessage For="@(() => Obj.MiddleName)" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">Full Address:</label>
                                    <FluentTextField @bind-Value="Obj.FullAddress" Class="form-control" />
                                    <ValidationMessage For="@(() => Obj.FullAddress)" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Birth Date:</label>
                                    <FluentDatePicker @bind-Value="@Obj.BirthDate" @bind-Value:after="OnCalculateAge" class="form-control" />
                                    <ValidationMessage For="@(() => Obj.LastName)" />
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Age:</label>
                                    <FluentNumberField @bind-Value="Obj.Age" Class="form-control" ReadOnly="true" />
                                    <ValidationMessage For="@(() => Obj.Age)" />
                                </div>
                            </div>

                            <div class="col-sm-12 col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Civil Status:</label>
                                    <FluentSelect TOption="CivilStatus"
                                                  Items="@CivilStatus_List"
                                                  Placeholder="Select civil status"
                                                  OptionValue="@(p => p.Id.ToString())"
                                                  OptionText="@(p => p.Description)"
                                                  @bind-Value="@Obj.CivilStatus"
                                                  @bind-SelectedOption="@SelectCivil"
                                                  Width="100%"
                                                  Class="form-control" />
                                    <ValidationMessage For="@(() => Obj.CivilStatus)" />
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Payment Type:</label>
                                    <InputSelect @bind-Value="@Obj.PayTypeMId"  Class="form-control" >                                        
                                        @if (PaymentType_List != null)
                                        {
                                            <option value="0">Select payment type</option>
                                            @foreach (var _item in PaymentType_List)
                                            {
                                                <option value="@_item.Id">@_item.Description</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">          
                                    @if(Obj.PayTypeMId == 1)
                                    {
                                        <label class="form-label">Receipt No:</label>
                                        <FluentTextField @bind-Value="Obj.Bank_Number" Class="form-control"  />
                                    }
                                    else if(Obj.PayTypeMId == 2)
                                    {
                                        <label class="form-label">Gcash / Maya:</label>
                                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom">
                                            <label class="form-label">+63</label>
                                          @*   <FluentNumberField @bind-Value="payNumber" Class="form-control" MaxLength="10" /> *@
                                            <FluentTextField @bind-Value="Obj.Bank_Number" Class="form-control" Maxlength="10" />
                                        </FluentStack>
                                    }
                                    else if (Obj.PayTypeMId == 3)
                                    {
                                        <label class="form-label">Account No.:</label>
                                        @* <FluentNumberField @bind-Value="payNumber" Class="form-control" /> *@
                                        <FluentTextField @bind-Value="Obj.Bank_Number" Class="form-control" />
                                    }
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Contact No:</label>
                                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom">
                                        <label class="form-label">+63</label>
                                        <FluentTextField @bind-Value="Obj.Contact" Class="form-control" Maxlength="10" />
                                    </FluentStack>
                                    <ValidationMessage For="@(() => Obj.Contact)" />
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Email Address:</label>
                                    <FluentTextField @bind-Value="Obj.EmailAdd" Class="form-control" />
                                    <ValidationMessage For="@(() => Obj.EmailAdd)" />
                                </div>
                            </div>                           
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">Referal Name:</label> 
                                    @if(Obj.MemberNo == "MN000000")
                                    {
                                        <FluentLabel Class="form-control">@ObjReferal?.ReferralName</FluentLabel>
                                    }
                                    else
                                    {
                                        <FluentLabel Class="form-control">@ObjReferal?.LastName, @ObjReferal?.FirstName</FluentLabel>
                                    }                                    
                                </div>
                            </div>
                        </div>

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top:20px;">
                            <FluentButton IconStart="@(new Icons.Regular.Size16.Save())" Appearance="Appearance.Accent" hidden="@isBtnNext" Type="ButtonType.Submit">
                                Next
                            </FluentButton>
                            <FluentButton IconStart="@(new Icons.Regular.Size16.LockClosed())" Appearance="Appearance.Accent" OnClick="OnCloseDialog" hidden="@isBtnCancel">
                                Cancel
                            </FluentButton>
                        </FluentStack>
                    </EditForm>
                </div>
            </FluentWizardStep>

            <FluentWizardStep Label="Step 2">              
                <div>
                    <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Center">
                        <FluentStack Orientation="Orientation.Vertical" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Center" style="border-color:#ced0d2;">
                            <div style="border: 2px solid #dee2e6;border-radius: 16px;display: flex;justify-content: center;margin-top: 12px;background-color: #fbfbfb;">
                                <img src="@ImgBase64" alt="dp" style="width: 100%;object-fit: fill;" hidden="@isImgShow" /> @* hidden="@isImgShow" *@
                                <video id="videoFeed" style="object-fit: fill;" width="320" height="260" hidden="@isCaptureShow" />    @* hidden="@isCaptureShow" *@
                                <canvas class="d-none" style="object-fit: fill;" id="currentFrame" width="320" height="260" hidden="@isCaptureShow" />     @* hidden="@isCaptureShow" *@
                            </div>
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" hidden="@isPhaseone">
                            <FluentInputFile @ref="@attachments"
                                             AnchorId="MyUploadStream"
                                             DragDropZoneVisible="false"
                                             Mode="InputFileMode.Stream"
                                             Multiple="true"
                                             MaximumFileSize="@(20 * 1024 * 1024)"
                                             Accept=".png, .jpg, .jpeg"
                                             OnInputFileChange="@OnFileUploadedAsync"
                                             hidden="@isUploadimg" />
                            <FluentButton Appearance="Appearance.Accent" Id="MyUploadStream" hidden="@isUploadimg">
                                Upload files
                            </FluentButton>
                            <FluentButton IconStart="@(new Icons.Regular.Size16.Camera())" OnClick="OnTakeImg">
                                Take Image
                            </FluentButton>
                        </FluentStack>

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" hidden="@isPhasetwo">
                            <FluentButton IconStart="@(new Icons.Regular.Size16.ClosedCaption())" OnClick="OnCloseImg">
                                Close Image
                            </FluentButton>
                            <FluentButton IconStart="@(new Icons.Regular.Size16.Camera())" OnClick="OnCaptureImg">
                                Capture Image
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" Style="margin-top:20px;">
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Save())" Appearance="Appearance.Accent" OnClick="OnBackTab" hidden="@isBtnBack">
                            Back
                        </FluentButton>
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Save())" Appearance="Appearance.Accent" OnClick="OnSaveData" hidden="@isBtnSave">
                            Save
                        </FluentButton>
                    </FluentStack>
                </div>
            </FluentWizardStep>
        </Steps>
        <ButtonTemplate></ButtonTemplate>
    </FluentWizard>
</FluentDialogBody>



@* <FluentTabs @bind-ActiveTabId="@activeid" OnTabChange="HandleOnTabChange">
    <FluentTab Label="Step 1"  Id="tab-1">

    </FluentTab>

    <FluentTab Label="Step 2" Id="tab-2" >

    </FluentTab>
</FluentTabs> *@

<FluentDialogFooter Visible="false">

</FluentDialogFooter>


