@implements IDialogContentComponent

<FluentDialogHeader ShowDismiss="true">
    <div class="d-flex flex-column">
        <FluentLabel Typo="Typography.PaneHeader">
            New Buyer
        </FluentLabel>
    </div>
</FluentDialogHeader>


<EditForm Model="@Obj">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @* <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label class="form-label">Shared Number:</label>
                <FluentTextField @bind-Value="Obj.Buy_Code" Class="form-control" ReadOnly="true" />
            </div>
        </div>
    </div> *@
    <br />
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label class="form-label">Share Points:</label>
                <FluentNumberField @bind-Value="Obj.Share_Points" Class="form-control" />
                <ValidationMessage For="@(() => Obj.Share_Points)" />
            </div>
        </div>
    </div>
</EditForm>

<FluentDialogFooter >
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">
        <FluentButton IconStart="@(new Icons.Regular.Size16.Save())" Appearance="Appearance.Accent" OnClick="OnSaveData">
            Save
        </FluentButton>
        <FluentButton IconStart="@(new Icons.Regular.Size16.LockClosed())" Appearance="Appearance.Accent" OnClick="OnCloseDialog">
            Cancel
        </FluentButton>
    </FluentStack>
</FluentDialogFooter>


